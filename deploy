#!/bin/bash
set -e

# ==============================================
#        FREE TIER VLESS WS TLS DEPLOYER
# ==============================================

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RESET='\033[0m'

echo -e "${CYAN}=========================================${RESET}"
echo -e "${CYAN}     VLESS WS TLS FREE DEPLOYER${RESET}"
echo -e "${CYAN}=========================================${RESET}"
echo ""

# ==============================================
# CHECK REQUIRED COMMANDS
# ==============================================

for cmd in gcloud docker curl; do
    if ! command -v $cmd &>/dev/null; then
        echo -e "${RED}Missing dependency:${RESET} $cmd"
        exit 1
    fi
done

# ==============================================
# ENABLE REQUIRED APIS
# ==============================================

echo -e "${CYAN}[*] Enabling required APIs...${RESET}"

gcloud services enable run.googleapis.com \
    cloudbuild.googleapis.com \
    artifactregistry.googleapis.com \
    --quiet

echo -e "${GREEN}[✔] APIs enabled${RESET}"

# ==============================================
# PROJECT
# ==============================================

PROJECT_ID=$(gcloud config get-value project 2>/dev/null)

if [ -z "$PROJECT_ID" ]; then
    echo -e "${RED}No GCP project selected.${RESET}"
    exit 1
fi

echo -e "${GREEN}[✔] Project:${RESET} $PROJECT_ID"

# ==============================================
# REGION
# ==============================================

REGION="us-central1"

# ==============================================
# SERVICE NAME
# ==============================================

read -p "Service name [default: vless]: " SERVICE_NAME
SERVICE_NAME=${SERVICE_NAME:-vless}

SERVICE_NAME=$(echo "$SERVICE_NAME" | tr '[:upper:]' '[:lower:]')

# ==============================================
# GENERATE UUID
# ==============================================

UUID=$(cat /proc/sys/kernel/random/uuid)

# ==============================================
# WS PATH
# ==============================================

WS_PATH="vpn"

# ==============================================
# CHECK FILES
# ==============================================

if [ ! -f Dockerfile ]; then
    echo -e "${RED}Dockerfile not found!${RESET}"
    exit 1
fi

if [ ! -f config.json ]; then
    echo -e "${RED}config.json not found!${RESET}"
    exit 1
fi

# ==============================================
# UPDATE UUID INSIDE CONFIG
# ==============================================

sed -i "s/UUID_HERE/$UUID/g" config.json
sed -i "s|WSPATH_HERE|/$WS_PATH|g" config.json

# ==============================================
# DOCKER AUTH
# ==============================================

echo -e "${CYAN}[*] Configuring docker auth...${RESET}"

gcloud auth configure-docker --quiet

# ==============================================
# IMAGE
# ==============================================

IMAGE="gcr.io/$PROJECT_ID/$SERVICE_NAME:latest"

# ==============================================
# BUILD IMAGE
# ==============================================

echo -e "${CYAN}[*] Building docker image...${RESET}"

docker build -t "$IMAGE" .

echo -e "${GREEN}[✔] Build complete${RESET}"

# ==============================================
# PUSH IMAGE
# ==============================================

echo -e "${CYAN}[*] Pushing image...${RESET}"

docker push "$IMAGE"

echo -e "${GREEN}[✔] Push complete${RESET}"

# ==============================================
# DEPLOY CLOUD RUN (FREE TIER FRIENDLY)
# ==============================================

echo -e "${CYAN}[*] Deploying to Cloud Run...${RESET}"

gcloud run deploy "$SERVICE_NAME" \
    --image "$IMAGE" \
    --platform managed \
    --region "$REGION" \
    --allow-unauthenticated \
    --port 8080 \
    --cpu 1 \
    --memory 512Mi \
    --concurrency 1000 \
    --timeout 3600 \
    --min-instances 0 \
    --max-instances 2 \
    --quiet

# ==============================================
# GET URL
# ==============================================

SERVICE_URL=$(gcloud run services describe "$SERVICE_NAME" \
    --region "$REGION" \
    --format='value(status.url)')

HOST=$(echo "$SERVICE_URL" | sed 's|https://||')

# ==============================================
# GENERATE VLESS URI
# ==============================================

VLESS_URI="vless://${UUID}@${HOST}:443?encryption=none&security=tls&type=ws&host=${HOST}&path=%2F${WS_PATH}&sni=${HOST}#GCP-Free"

# ==============================================
# OUTPUT
# ==============================================

echo ""
echo -e "${GREEN}=========================================${RESET}"
echo -e "${GREEN}        DEPLOYMENT SUCCESSFUL${RESET}"
echo -e "${GREEN}=========================================${RESET}"
echo ""

echo -e "${CYAN}Host:${RESET} $HOST"
echo -e "${CYAN}Port:${RESET} 443"
echo -e "${CYAN}UUID:${RESET} $UUID"
echo -e "${CYAN}WS Path:${RESET} /$WS_PATH"
echo ""

echo -e "${YELLOW}VLESS URI:${RESET}"
echo "$VLESS_URI"

echo ""

# ==============================================
# OPTIONAL QR CODE
# ==============================================

if command -v qrencode &>/dev/null; then
    echo -e "${CYAN}QR CODE:${RESET}"
    echo "$VLESS_URI" | qrencode -t ANSIUTF8
fi

echo ""
echo -e "${GREEN}Done.${RESET}"
